# Скопируйте этот файл в .env и заполните своими значениями.
# Не публикуйте .env: он содержит пароль и OAuth-секрет.

# Откройте https://stepik.org/oauth2/applications/ и создайте приложение.
# Выберите Client type: Confidential.
# Выберите Authorization grant type: Resource owner password-based.
# Redirect URI для этого скрипта не нужен: он не использует браузерный редирект.
STEPIK_CLIENT_ID=your_stepik_client_id
STEPIK_CLIENT_SECRET=your_stepik_client_secret

# Учётная запись с доступом к скачиваемому курсу.
STEPIK_USERNAME=your_email@example.com
STEPIK_PASSWORD=your_stepik_password

# Адрес API Stepik. Обычно менять не нужно.
STEPIK_API_HOST=https://stepik.org

# ID курса из адреса вида https://stepik.org/course/272771
STEPIK_COURSE_ID=272771

# true — продолжать незавершённую выгрузку, не перезаписывая готовые файлы.
# false — скачать и перезаписать все шаги заново.
STEPIK_SKIP_EXISTING=true

# Необязательные настройки производительности.
STEPIK_MAX_WORKERS=8
STEPIK_BATCH_SIZE=5
